# Local development (match server PORT in server/.env)
NEXT_PUBLIC_API_URL=http://localhost:2000/api

# Optional: override Socket.io origin (defaults to NEXT_PUBLIC_API_URL without /api)
# Production example: https://your-app.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com

# Google OAuth (same Client ID as server GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Sign In (Services ID, same as server APPLE_CLIENT_ID)
NEXT_PUBLIC_APPLE_CLIENT_ID=

# --- Production (Vercel) ---
# NEXT_PUBLIC_API_URL=https://your-app.onrender.com/api
# NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com
# Add your Vercel URL to Google/Apple authorized origins and server CLIENT_URL
